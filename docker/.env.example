# Public hostname. Its DNS A/AAAA record must point at this server
# before first start so Caddy can obtain a certificate.
WHOOSH_DOMAIN=whoosh.example.com

# Optional overrides
# WHOOSH_ALLOWED_ORIGINS=https://whoosh.example.com
# WHOOSH_LOG_LEVEL=INFO
# WHOOSH_ROOM_CREATE_PER_MINUTE=10
# WHOOSH_HTTP_PORT=80
# WHOOSH_HTTPS_PORT=443

# TURN relay for peers behind strict NATs (optional; start the stack with
# --profile turn). Use a long random secret: openssl rand -hex 32
# WHOOSH_TURN_SECRET=
# WHOOSH_TURN_URLS=turn:whoosh.example.com:3478?transport=udp,turn:whoosh.example.com:3478?transport=tcp
